---
// src/components/ui/FormattedDate.astro
interface Props {
    date: Date;
}

const { date } = Astro.props;
---

<time datetime={date.toISOString()}>
    {
        date.toLocaleDateString("ru-RU", {
            timeZone: "Europe/Moscow",
            year: "numeric",
            month: "short",
            day: "numeric",
        })
    }
</time>
