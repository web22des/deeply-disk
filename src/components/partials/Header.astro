---
//src/components/partials/Header.astro
import LinkActive from "@components/ui/link/LinkActive.astro";
import Link from "@components/ui/link/Link.astro";
---

<header class="header">
    <div class="header__container">
        <nav>
            <div>
                <h2>
                    <Link href="/">Astro Starter Kit - deeply-disk </Link>
                </h2>
                <span>version: "1.0.0"</span>
            </div>
            <ul class="internal-links">
                <LinkActive href="/">Главная</LinkActive>
                <LinkActive href="/catalog/">Страница</LinkActive>
                <LinkActive href="/blog/">Блог</LinkActive>
                <LinkActive href="/contacts/">Контакты</LinkActive>
            </ul>
        </nav>
    </div>
</header>

<style lang="scss">
    nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .header {
        background-color: var(--md-sys-color-on-secondary-fixed);
        &__container {
            color: var(--md-sys-color-secondary-fixed);
        }
        &__container {
            padding-top: 12px;
            padding-bottom: 12px;
        }
    }
    h2 {
        span {
            padding-left: 8px;
            font-size: 12px;
            text-transform: none;
            display: inline-block;
        }
    }

    .internal-links {
        display: flex;
        gap: 50px;
    }
</style>
